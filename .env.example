# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FALLBACK_LANGUAGE=en

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=medium
DB_LOGGING=false

# Redis (blacklist token, queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Storage (file upload private)
STORAGE_PRIVATE_PATH=storage/private

# Mail (Mailpit: web UI http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Medium Clone <no-reply@medium.local>"
ADMIN_EMAIL=admin@medium.local
CRON_TIMEZONE=Asia/Ho_Chi_Minh
