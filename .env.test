# e2e test environment: SEPARATE database, redis db and file directory (never touches dev data)
NODE_ENV=test
PORT=3001
APP_URL=http://localhost:3001
FALLBACK_LANGUAGE=en

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=medium_test
DB_LOGGING=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

JWT_SECRET=test-secret
JWT_EXPIRES_IN=1h

STORAGE_PRIVATE_PATH=storage/test
